<Project>

  <Sdk Name="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>AndreyTalanin0x00.Extensions.DependencyInjection</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Andrey Talanin</Authors>
    <Description>A set of utility classes and extension methods for .NET dependency injection.</Description>
    <RepositoryUrl>https://github.com/AndreyTalanin0x00/AndreyTalanin0x00.Extensions.DependencyInjection.git</RepositoryUrl>
    <Version>0.1.0-rc1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndreyTalanin0x00.Extensions.DependencyInjection.Abstractions\AndreyTalanin0x00.Extensions.DependencyInjection.Abstractions.csproj" />
  </ItemGroup>

</Project>
